/* Globale Basis-Styles für ProMA */
:root {
  --primary: #1a73e8;
  --danger: #d93025;
  --warning-bg: #fef7e0;
  --warning-border: #f9ab00;
  --text: #202124;
  --muted: #5f6368;
  --border: #dadce0;
}

body {
  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  color: var(--text);
  margin: 0;
  background: #fafafa;
}

button {
  font: inherit;
  cursor: pointer;
}

input,
textarea,
select {
  font: inherit;
}
